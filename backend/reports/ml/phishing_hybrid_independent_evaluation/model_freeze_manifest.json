  "routing_rules": {
    "detection_rules": {
      "html_detection_regex": "(?is)<\\s*(?:!doctype\\s+html|html|head|body|meta|link|a|form|div|p)\\b",
      "long_message_threshold_chars": 1000,
      "short_message_threshold_chars": 100,
      "short_url_only_criteria": "text_len <= 100 AND has_urls == True AND is_html == False"
    },
    "candidate_policies": {
      "policy_1": {
        "name": "Policy 1 (V2 All)",
        "routing_rule": "Route all inputs to V2"
      },
      "policy_2": {
        "name": "Policy 2 (V3 Dual All)",
        "routing_rule": "Route all inputs to V3 Dual-Channel"
      },
      "policy_3": {
        "name": "Policy 3 (HTML -> V3 Dual, else V2) [Primary Candidate]",
        "routing_rule": "If match(html_detection_regex) -> route to V3 Dual; Else -> route to V2"
      },
      "policy_4": {
        "name": "Policy 4 (HTML or Long -> V3 Dual, else V2) [Alternative Candidate]",
        "routing_rule": "If match(html_detection_regex) OR length(text) > 1000 -> route to V3 Dual; Else -> route to V2"
      }
    }
  },
  "evaluation_thresholds": {
    "primary_threshold": 0.50,
