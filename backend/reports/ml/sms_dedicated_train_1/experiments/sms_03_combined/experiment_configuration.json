{
  "model_id": "sms_03_combined",
  "model_name": "SMS-03: Combined Word + Character FeatureUnion + Logistic Regression",
  "pipeline_steps": [
    {
      "name": "features",
      "class": "FeatureUnion",
      "transformer_list": [
        {
          "name": "word_branch",
          "class": "TfidfVectorizer",
          "params": {
            "analyzer": "word",
            "ngram_range": [
              1,
              2
            ],
            "sublinear_tf": true,
            "lowercase": true,
            "max_features": 25000,
            "min_df": 2
          }
        },
        {
          "name": "char_branch",
          "class": "TfidfVectorizer",
          "params": {
            "analyzer": "char_wb",
            "ngram_range": [
              3,
              5
            ],
            "sublinear_tf": true,
            "lowercase": true,
            "max_features": 50000,
            "min_df": 3
          }
        }
      ]
    },
    {
      "name": "classifier",
      "class": "LogisticRegression",
      "params": {
        "C": 1.0,
        "penalty": "l2",
        "solver": "liblinear",
        "class_weight": "balanced",
        "random_state": 20261102,
        "max_iter": 1000
      }
    }
  ],
  "input_modality": "sanitized plain-text mobile SMS",
  "preprocessing": "Unicode NFKC normalization, lowercased, collapsed whitespace, inert URL retention",
  "target_encoding": {
    "smishing": 1,
    "ham": 0,
    "commercial_spam": 0
  }
}