{
  "model_id": "sms_01_word",
  "model_name": "SMS-01: Word TF-IDF + Logistic Regression",
  "pipeline_steps": [
    {
      "name": "tfidf",
      "class": "TfidfVectorizer",
      "params": {
        "analyzer": "word",
        "ngram_range": [
          1,
          2
        ],
        "sublinear_tf": true,
        "lowercase": true,
        "max_features": 25000,
        "min_df": 2
      }
    },
    {
      "name": "classifier",
      "class": "LogisticRegression",
      "params": {
        "C": 1.0,
        "penalty": "l2",
        "solver": "liblinear",
        "class_weight": "balanced",
        "random_state": 20261102,
        "max_iter": 1000
      }
    }
  ],
  "input_modality": "sanitized plain-text mobile SMS",
  "preprocessing": "Unicode NFKC normalization, lowercased, collapsed whitespace, inert URL retention",
  "target_encoding": {
    "smishing": 1,
    "ham": 0,
    "commercial_spam": 0
  }
}