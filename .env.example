# SignalCheck Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# Never commit active secrets or credentials to version control.

# Allowed CORS Origins (comma-separated list of origins)
# Wildcards (*) are rejected. Each origin must specify http:// or https:// with hostname and optional port.
# Default if unset: http://localhost:5173,http://127.0.0.1:5173
SIGNALCHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Application-Level Rate Limiting
# Configures endpoint-specific or global maximum request rates per client IP.
# Format: <count>/<second|minute|hour|day>
SIGNALCHECK_RATE_LIMIT_DEFAULT=30/minute
SIGNALCHECK_RATE_LIMIT_ANALYZE=30/minute
SIGNALCHECK_RATE_LIMIT_SMS=30/minute
SIGNALCHECK_RATE_LIMIT_ANDROID=20/minute
SIGNALCHECK_RATE_LIMIT_APK=5/minute

# APK Static Analysis Protection Limits
# Max file size accepted in bytes (default: 26214400 = 25 MB)
SIGNALCHECK_APK_MAX_SIZE_BYTES=26214400
# Hard timeout in seconds for static parsing (default: 20)
SIGNALCHECK_APK_TIMEOUT_SECONDS=20
# Max uncompressed size limit in bytes for zip-bomb protection (default: 314572800 = 300 MB)
SIGNALCHECK_APK_MAX_UNCOMPRESSED_BYTES=314572800
# Max entry count inside APK zip container (default: 10000)
SIGNALCHECK_APK_MAX_ENTRIES=10000
# Max compression ratio for zip-bomb protection (default: 20.0)
SIGNALCHECK_APK_MAX_COMPRESSION_RATIO=20.0

# Rate Limiting Storage Backend URI
# Use memory:// for local single-process development.
# Use redis://redis:6379/0 for multi-worker containerized deployments.
SIGNALCHECK_RATE_LIMIT_STORAGE_URL=redis://redis:6379/0

# Docker Compose Published Ports
SIGNALCHECK_HTTP_PORT=80
SIGNALCHECK_HTTPS_PORT=443

# Trusted Proxy IP Addresses (comma-separated list of IP addresses)
# Only proxies listed here will have their X-Forwarded-For headers honored for client IP resolution.
# If unset or empty, the direct socket connection IP is used (prevents client header spoofing).
# Example for local reverse proxy: 127.0.0.1,10.0.0.1
SIGNALCHECK_TRUSTED_PROXIES=

# Allowed Hostnames (TrustedHostMiddleware)
# Comma-separated list of hostnames permitted in the HTTP Host header.
# Default if unset: localhost,127.0.0.1,testserver
SIGNALCHECK_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Server Bindings (used when launching via production process managers)
# PORT=8000
# HOST=127.0.0.1
